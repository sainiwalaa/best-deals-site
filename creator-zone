<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creator Zone - Sainiwalaa</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <style>
        :root { --accent: #ff0050; --blue: #0095f6; --bg: #fafafa; }
        * { margin:0; padding:0; box-sizing:border-box; font-family: 'Poppins', sans-serif; }
        body { background: var(--bg); color: #262626; padding-bottom: 60px; }

        /* --- PROFILE SECTION --- */
        .banner { width: 100%; height: 150px; background: #333 url('https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80') center/cover; }
        
        .profile-container { max-width: 600px; margin: auto; padding: 0 15px; position: relative; }
        .profile-top { display: flex; align-items: flex-end; margin-top: -45px; gap: 15px; }
        .pfp { width: 90px; height: 90px; border-radius: 50%; border: 4px solid #fff; background: #eee; object-fit: cover; }
        
        .user-info { margin-top: 10px; }
        .user-info h2 { font-size: 20px; font-weight: 700; display: flex; align-items: center; gap: 5px; }
        .verified-badge { color: #0095f6; font-size: 16px; }
        
        .bio { font-size: 13px; margin: 8px 0; color: #555; line-height: 1.4; }
        .stats { display: flex; gap: 20px; margin: 15px 0; border-top: 1px solid #eee; border-bottom: 1px solid #eee; padding: 10px 0; }
        .stats div { text-align: center; flex: 1; font-size: 13px; }
        .stats b { display: block; font-size: 16px; }

        .action-btns { display: flex; gap: 10px; }
        .btn { flex: 1; padding: 8px; border-radius: 8px; border: none; font-weight: 600; cursor: pointer; font-size: 13px; }
        .btn-follow { background: var(--blue); color: #fff; }
        .btn-msg { background: #efefef; color: #000; }

        /* --- POST CREATOR (MODAL STYLE) --- */
        .create-post-card { background: #fff; margin: 20px 0; padding: 15px; border-radius: 12px; border: 1px solid #ddd; }
        .upload-box { border: 2px dashed #ccc; border-radius: 10px; padding: 20px; text-align: center; cursor: pointer; margin-bottom: 10px; }
        .preview-area { display: flex; gap: 5px; margin-top: 10px; overflow-x: auto; }
        .preview-area img { width: 80px; height: 80px; object-fit: cover; border-radius: 5px; }

        /* --- FEED --- */
        .feed-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; margin-top: 20px; }
        .post-item { aspect-ratio: 1/1; background: #ddd; position: relative; overflow: hidden; cursor: pointer; }
        .post-item img { width: 100%; height: 100%; object-fit: cover; }
        .video-icon { position: absolute; top: 8px; right: 8px; color: #fff; font-size: 12px; background: rgba(0,0,0,0.4); padding: 2px 5px; border-radius: 4px; }

        input, textarea { width: 100%; padding: 10px; margin-top: 8px; border: 1px solid #ddd; border-radius: 6px; font-size: 13px; outline: none; }
    </style>
</head>
<body>

    <div class="banner"></div>
    <div class="profile-container">
        <div class="profile-top">
            <img src="https://i.pravatar.cc/150?img=12" class="pfp">
            <div style="flex-grow:1; padding-bottom: 5px;">
                <div class="action-btns">
                    <button class="btn btn-follow" id="followBtn" onclick="toggleFollow()">Follow</button>
                    <button class="btn btn-msg">Message</button>
                </div>
            </div>
        </div>

        <div class="user-info">
            <h2>sainiwala_official <span class="verified-badge">✔</span></h2>
            <div class="bio">
                ✨ Digital Creator | Jaipur <br>
                🧵 Premium Ethnic Wear & T-Shirts <br>
                📦 Delivery across India 🇮🇳
            </div>
        </div>

        <div class="stats">
            <div><b>124</b> Posts</div>
            <div><b>15.4K</b> Followers</div>
            <div><b>230</b> Following</div>
        </div>

        <hr style="opacity: 0.2;">

        <div class="create-post-card">
            <h4 style="font-size: 14px; margin-bottom:10px;">New Post (Max 3 Images or 1 Video)</h4>
            <div class="upload-box" onclick="document.getElementById('fileInput').click()">
                <span id="uploadText">📸 Click to upload Media</span>
                <input type="file" id="fileInput" hidden multiple accept="image/*,video/*" onchange="previewFiles()">
            </div>
            <div class="preview-area" id="previewArea"></div>
            <textarea id="postDesc" placeholder="Write a description..."></textarea>
            <input type="text" id="postTags" placeholder="#hashtags #style">
            <button class="btn btn-follow" style="margin-top:10px; width: 100%;" onclick="uploadPost()">Post Now</button>
        </div>

        <h4 style="margin: 20px 0 10px; font-size: 14px;">Recent Posts</h4>
        <div class="feed-grid" id="feed">
            <div class="post-item">
                <img src="https://picsum.photos/400/400?random=1">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/400/400?random=2">
                <div class="video-icon">▶ 90s</div>
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/400/400?random=3">
            </div>
            <div class="post-item">
                <img src="https://picsum.photos/400/400?random=4">
            </div>
        </div>
    </div>

    <script>
        // Toggle Follow Button
        function toggleFollow() {
            const btn = document.getElementById('followBtn');
            if(btn.innerText === "Follow") {
                btn.innerText = "Following";
                btn.classList.replace('btn-follow', 'btn-msg');
            } else {
                btn.innerText = "Follow";
                btn.classList.replace('btn-msg', 'btn-follow');
            }
        }

        // Preview uploaded images/video
        function previewFiles() {
            const previewArea = document.getElementById('previewArea');
            const files = document.getElementById('fileInput').files;
            previewArea.innerHTML = "";
            
            if(files.length > 3) {
                alert("Sirf 3 images allow hain!");
                return;
            }

            Array.from(files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    previewArea.appendChild(img);
                }
                reader.readAsDataURL(file);
            });
        }

        // Post Upload Logic (UI only)
        function uploadPost() {
            const desc = document.getElementById('postDesc').value;
            const tags = document.getElementById('postTags').value;
            const preview = document.getElementById('previewArea');

            if(!desc) {
                alert("Description likhna zaroori hai!");
                return;
            }

            // Simple Animation
            alert("Order Processing... Post Successful!");
            
            // Clear fields
            document.getElementById('postDesc').value = "";
            document.getElementById('postTags').value = "";
            preview.innerHTML = "";
        }
    </script>
</body>
</html>
